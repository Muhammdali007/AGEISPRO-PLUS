ENVIRONMENT=production
DOMAIN=aegispro.example.com
TLS_CERT_DIR=./infra/certs
API_WORKERS=1
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

POSTGRES_DB=aegispro
POSTGRES_USER=aegispro
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg://aegispro:replace-with-a-strong-postgres-password@postgres:5432/aegispro
POSTGRES_EXPORTER_DSN=postgresql://aegispro:replace-with-a-strong-postgres-password@postgres:5432/aegispro?sslmode=disable

REDIS_URL=redis://redis:6379/0
AI_SERVICE_URL=http://ai:8100

SECRET_KEY=replace-with-a-long-random-secret
SERVICE_CALLBACK_TOKEN=replace-with-a-long-random-service-token
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
SENDGRID_API_KEY=replace-with-sendgrid-api-key
PASSWORD_RESET_FROM_EMAIL=security@your-domain.example.com
PASSWORD_RESET_FROM_NAME=AegisPro Security
WEB_APP_URL=https://your-domain.example.com
PASSWORD_RESET_TOKEN_MINUTES=30

CORS_ORIGINS=https://your-domain.example.com
AUTO_CREATE_TABLES=false
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
STORAGE_ROOT=/app/storage
API_CONTINUOUS_DETECTION_ENABLED=true
API_CONTINUOUS_DETECTION_BATCH_SIZE=4
API_CONTINUOUS_DETECTION_MAX_PENDING_PER_CAMERA=1
API_CONTINUOUS_DETECTION_SCHEDULER_INTERVAL_MS=250
API_CONTINUOUS_DETECTION_HAZARD_INTERVAL_SECONDS=0.5
API_CONTINUOUS_DETECTION_RECOGNITION_INTERVAL_SECONDS=4.0
API_FILE_VIDEO_SCAN_STEP_SECONDS=0.5
API_DETECTION_DUPLICATE_WINDOW_SECONDS=15
API_SOUND_ALERT_UNKNOWN_SCAN_THRESHOLD=3
API_SOUND_ALERT_UNKNOWN_COOLDOWN_SECONDS=30
API_SOUND_ALERT_HAZARD_COOLDOWN_SECONDS=10
API_EVENT_CLIP_FPS=10
API_INCIDENT_RETENTION_HOURS=24
API_INCIDENT_EXTENDED_RETENTION_HOURS=72
API_INCIDENT_COMPLIANCE_RETENTION_HOURS=168
API_INCIDENT_CLEANUP_INTERVAL_SECONDS=60

VIDEO_RAG_ENABLED=false
VIDEO_RAG_OLLAMA_URL=http://host.docker.internal:11434
VIDEO_RAG_VISION_MODEL=gemma3:4b
VIDEO_RAG_EMBEDDING_MODEL=embeddinggemma
VIDEO_RAG_EMBEDDING_DIMENSIONS=768
VIDEO_RAG_REQUEST_TIMEOUT_SECONDS=120
VIDEO_RAG_VISUAL_INDEXING_ENABLED=true
VIDEO_RAG_QUERY_TIMEOUT_SECONDS=30
VIDEO_RAG_WORKER_INTERVAL_SECONDS=15
VIDEO_RAG_LEASE_SECONDS=600
VIDEO_RAG_MAX_ATTEMPTS=3
VIDEO_RAG_MAX_FRAMES=6
VIDEO_RAG_EVIDENCE_READ_TIMEOUT_SECONDS=15
VIDEO_RAG_DEFAULT_LIMIT=5
VIDEO_RAG_MIN_RELEVANCE=0.25

AI_MODEL_BACKEND=ultralytics
AI_MODEL_NAME=aegispro-multimodel-yolo11n
AI_MODEL_VERSION=replace-with-model-release-id
AI_MODEL_FALLBACK_BACKEND=ultralytics
AI_ALLOW_BACKEND_FALLBACK=false
AI_MODEL_WEIGHTS_PATH=/app/storage/models/yolo11n.pt
AI_MODEL_PERSON_WEAPON_WEIGHTS_PATH=/app/storage/models/yolo11n.pt
AI_MODEL_WEAPON_WEIGHTS_PATH=/app/storage/models/weapon.pt
AI_MODEL_WEAPON_ENSEMBLE_GENERAL=true
AI_MODEL_WEAPON_EXCLUDED_LABELS=scissor,scissors
AI_MODEL_FIRE_SMOKE_WEIGHTS_PATH=/app/storage/models/fire-smoke.pt
AI_MODEL_FIRE_WEIGHTS_PATH=/app/storage/models/fire.pt
AI_MODEL_SMOKE_WEIGHTS_PATH=/app/storage/models/smoke.pt
AI_MODEL_WEAPON_PROMOTION_PATH=/app/storage/models/weapon.pt.promotion.json
AI_MODEL_FIRE_SMOKE_PROMOTION_PATH=/app/storage/models/fire-smoke.pt.promotion.json
AI_MODEL_FIRE_PROMOTION_PATH=/app/storage/models/fire.pt.promotion.json
AI_MODEL_SMOKE_PROMOTION_PATH=/app/storage/models/smoke.pt.promotion.json
AI_MODEL_DEVICE=0
AI_MODEL_IMAGE_SIZE=640
AI_MODEL_HALF_PRECISION=false
AI_MODEL_BATCH_SIZE=8
AI_MODEL_IOU_THRESHOLD=0.60
AI_MODEL_MAX_DETECTIONS=100
AI_MODEL_MAX_THREAT_DETECTIONS_PER_TYPE=3
AI_MODEL_WEAPON_GENERAL_FALLBACK_CONFIDENCE=0.72
AI_MODEL_GENERIC_WEAPON_MIN_CONFIDENCE=0.65
AI_MODEL_TRACKER_CONFIG=bytetrack.yaml
AI_MODEL_TRACK_PERSIST=true
AI_MODEL_ENABLE_TRACKING=true
AI_MODEL_SNAPSHOT_TRACK_MAX_AGE_SECONDS=3.0
AI_MODEL_SNAPSHOT_TRACK_MIN_IOU=0.08
AI_MODEL_SNAPSHOT_TRACK_MAX_CENTER_DISTANCE=0.8
AI_MODEL_SNAPSHOT_TRACK_VELOCITY_ALPHA=0.65
AI_MODEL_PRELOAD_ON_STARTUP=true
AI_MODEL_RUNTIME_AUTOINSTALL=false
AI_CONFIDENCE_THRESHOLD=0.55
AI_PERSON_CONFIDENCE_THRESHOLD=0.35
AI_WEAPON_CONFIDENCE_THRESHOLD=0.25
AI_FIRE_CONFIDENCE_THRESHOLD=0.07
AI_SMOKE_CONFIDENCE_THRESHOLD=0.05
AI_SMOKE_MAX_PERSON_COVERAGE=0.70
AI_SMOKE_PERSON_CONFLICT_MIN_CONFIDENCE=0.35
AI_THREAT_EDGE_STRIP_MARGIN_RATIO=0.04
AI_THREAT_EDGE_STRIP_MAX_WIDTH_RATIO=0.18
AI_THREAT_EDGE_STRIP_MIN_HEIGHT_RATIO=0.45
AI_THREAT_EDGE_STRIP_MIN_ASPECT_RATIO=4.0
AI_MODEL_PROMOTION_MIN_SIGNATURES=2
AI_MODEL_PROMOTION_WEAPON_MIN_RECALL=0.90
AI_INFERENCE_FPS=5

AI_RECOGNITION_BACKEND=insightface
AI_RECOGNITION_ALLOW_FALLBACK=false
AI_RECOGNITION_MATCH_THRESHOLD=0.50
AI_RECOGNITION_MIN_MARGIN=0.05
AI_RECOGNITION_REFRESH_SECONDS=2.0
AI_RECOGNITION_KNOWN_REFRESH_SECONDS=5.0
AI_RECOGNITION_MIN_FACE_DETECTION_SCORE=0.35
AI_RECOGNITION_MIN_FACE_SIZE=24
AI_RECOGNITION_CACHE_IOU_THRESHOLD=0.45
AI_RECOGNITION_TEMPLATE_TOP_K=3
AI_RECOGNITION_TEMPLATE_MIN_DET_SCORE=0.60
AI_RECOGNITION_TEMPLATE_DUPLICATE_SIMILARITY=0.9995
AI_TEMPORAL_CONFIRMATION_ENABLED=true
AI_TEMPORAL_CONFIRMATION_MAX_GAP_SECONDS=2.0
AI_TEMPORAL_CONFIRMATION_ALLOWED_MISSES=1
AI_WEAPON_CONFIRMATION_FRAMES=2
AI_FIRE_CONFIRMATION_FRAMES=2
AI_SMOKE_CONFIRMATION_FRAMES=2
AI_RECOGNITION_CONFIRMATION_FRAMES=2
AI_WEAPON_IMMEDIATE_CONFIDENCE=0.60
AI_FIRE_IMMEDIATE_CONFIDENCE=0.65
AI_SMOKE_IMMEDIATE_CONFIDENCE=0.70
AI_RECOGNITION_IMMEDIATE_CONFIDENCE=0.90
AI_RECOGNITION_INSIGHTFACE_MODEL=buffalo_m
AI_RECOGNITION_INSIGHTFACE_PROVIDERS=CPUExecutionProvider
AI_RECOGNITION_INSIGHTFACE_CTX_ID=-1
AI_RECOGNITION_INSIGHTFACE_DET_SIZE=640x640

AI_ENABLE_EVENT_CALLBACK=true
AI_API_EVENT_CALLBACK_URL=http://api:8000/api/v1/detections/ingest
AI_API_EVENT_CALLBACK_TOKEN=replace-with-a-long-random-service-token
AI_RUNTIME_GATE_REPORT_PATH=/app/storage/runtime/runtime-gates.json

API_RECOGNITION_BACKEND=insightface
API_RECOGNITION_ALLOW_FALLBACK=false
API_RECOGNITION_INSIGHTFACE_MODEL=buffalo_m
API_RECOGNITION_INSIGHTFACE_PROVIDERS=CPUExecutionProvider
API_RECOGNITION_INSIGHTFACE_CTX_ID=-1
API_RECOGNITION_INSIGHTFACE_DET_SIZE=640x640
API_RECOGNITION_ENROLLMENT_MIN_DET_SCORE=0.60
API_RECOGNITION_ENROLLMENT_MIN_FACE_SIZE=48
API_RECOGNITION_ENROLLMENT_REQUIRE_SINGLE_FACE=true
API_RECOGNITION_RUNTIME_MAX_TEMPLATES_PER_PERSON=12
API_RECOGNITION_RUNTIME_TEMPLATE_MIN_DET_SCORE=0.60
API_RECOGNITION_RUNTIME_TEMPLATE_DUPLICATE_SIMILARITY=0.9995

WEB_PUBLIC_API_URL=/backend
WEB_API_PROXY_TARGET=http://api:8000
