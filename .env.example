PROJECT_NAME=AegisPro
ENVIRONMENT=development

POSTGRES_DB=aegispro
POSTGRES_USER=aegispro
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_AI_SERVICE_URL=http://127.0.0.1:8100
API_SECRET_KEY=replace-with-a-long-random-secret
API_SERVICE_CALLBACK_TOKEN=replace-with-a-long-random-service-token
API_ACCESS_TOKEN_MINUTES=30
API_REFRESH_TOKEN_DAYS=7
API_DATABASE_POOL_SIZE=10
API_DATABASE_MAX_OVERFLOW=20
API_DATABASE_POOL_RECYCLE_SECONDS=1800

AI_HOST=127.0.0.1
AI_PORT=8100
AI_MODEL_BACKEND=ultralytics
AI_MODEL_FALLBACK_BACKEND=simulated
AI_ALLOW_BACKEND_FALLBACK=false
AI_MODEL_NAME=aegispro-multimodel-yolov8m
AI_MODEL_VERSION=local-trained
AI_MODEL_WEIGHTS_PATH=storage/models/yolo11n.pt
AI_MODEL_PERSON_WEAPON_WEIGHTS_PATH=storage/models/yolov8m.pt
AI_MODEL_WEAPON_WEIGHTS_PATH=storage/models/weapon.pt
AI_MODEL_FIRE_SMOKE_WEIGHTS_PATH=storage/models/fire-smoke.pt
AI_MODEL_TRACKER_CONFIG=bytetrack.yaml
AI_MODEL_IMAGE_SIZE=640
AI_MODEL_HALF_PRECISION=false
AI_INFERENCE_FPS=5
AI_CONFIDENCE_THRESHOLD=0.55
AI_PERSON_CONFIDENCE_THRESHOLD=0.35
AI_WEAPON_CONFIDENCE_THRESHOLD=0.12
AI_FIRE_CONFIDENCE_THRESHOLD=0.15
AI_SMOKE_CONFIDENCE_THRESHOLD=0.05
AI_RECOGNITION_BACKEND=insightface
AI_RECOGNITION_EMBEDDING_MODEL=image-hash-v1
AI_RECOGNITION_EMBEDDING_DIMENSIONS=16
AI_RECOGNITION_ALLOW_FALLBACK=false
AI_RECOGNITION_MIN_MARGIN=0.08
AI_RECOGNITION_INSIGHTFACE_MODEL=buffalo_l
AI_RECOGNITION_INSIGHTFACE_PROVIDERS=CPUExecutionProvider
AI_RECOGNITION_INSIGHTFACE_CTX_ID=-1
AI_RECOGNITION_INSIGHTFACE_DET_SIZE=640x640
AI_ENABLE_EVENT_CALLBACK=false
AI_API_EVENT_CALLBACK_URL=http://127.0.0.1:8000/api/v1/detections/ingest
AI_API_EVENT_CALLBACK_TOKEN=replace-with-a-long-random-service-token
API_CONTINUOUS_DETECTION_ENABLED=true
API_DETECTION_DUPLICATE_WINDOW_SECONDS=15

API_RECOGNITION_BACKEND=insightface
API_RECOGNITION_EMBEDDING_MODEL=image-hash-v1
API_RECOGNITION_EMBEDDING_DIMENSIONS=16
API_RECOGNITION_ALLOW_FALLBACK=false
API_RECOGNITION_INSIGHTFACE_MODEL=buffalo_l
API_RECOGNITION_INSIGHTFACE_PROVIDERS=CPUExecutionProvider
API_RECOGNITION_INSIGHTFACE_CTX_ID=-1
API_RECOGNITION_INSIGHTFACE_DET_SIZE=640x640

WEB_PUBLIC_API_URL=http://localhost:8000
WEB_API_PROXY_TARGET=http://127.0.0.1:8000
