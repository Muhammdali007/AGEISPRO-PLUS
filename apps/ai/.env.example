PROJECT_NAME=AegisPro AI Service
ENVIRONMENT=development
AI_MODEL_BACKEND=ultralytics
AI_MODEL_FALLBACK_BACKEND=simulated
AI_ALLOW_BACKEND_FALLBACK=true
AI_MODEL_WEIGHTS_PATH=storage/models/yolo11n.pt
AI_MODEL_PERSON_WEAPON_WEIGHTS_PATH=storage/models/yolov8m.pt
AI_MODEL_WEAPON_WEIGHTS_PATH=storage/models/weapon.pt
AI_MODEL_FIRE_SMOKE_WEIGHTS_PATH=storage/models/fire-smoke.pt
AI_MODEL_TRACKER_CONFIG=bytetrack.yaml
AI_PERSON_CONFIDENCE_THRESHOLD=0.35
AI_WEAPON_CONFIDENCE_THRESHOLD=0.12
AI_FIRE_CONFIDENCE_THRESHOLD=0.15
AI_SMOKE_CONFIDENCE_THRESHOLD=0.05
# Local checkpoint paths are resolved relative to the repository root and the storage/models folder.
AI_RECOGNITION_BACKEND=insightface
AI_RECOGNITION_ALLOW_FALLBACK=false
AI_ENABLE_EVENT_CALLBACK=false
AI_API_EVENT_CALLBACK_URL=http://127.0.0.1:8000/api/v1/detections/ingest
AI_API_EVENT_CALLBACK_TOKEN=replace-with-a-long-random-service-token
